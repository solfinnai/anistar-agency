{"cleanUrls":true,"trailingSlash":true,
 "headers":[{"source":"/(.*)\\.(css|js)","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
  {"source":"/(.*)\\.(svg|png|jpg|jpeg|webp)","headers":[{"key":"Cache-Control","value":"public, max-age=3600, must-revalidate"}]},
  {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}]}
